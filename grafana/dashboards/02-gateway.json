          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total, route)",
          "refId": "route-var"
        },
        "definition": "label_values(http_requests_total, route)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "regex": "",
        "current": {},
        "options": [],
        "hide": 0,

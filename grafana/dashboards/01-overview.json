    {
      "type": "stat",
      "title": "gRPC server errors/s",
      "description": "INTERNAL, UNKNOWN, UNAVAILABLE and similar codes returned by any service. Business errors like NOT_FOUND or ALREADY_EXISTS are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(grpc_requests_total{status=~\"INTERNAL|UNKNOWN|UNAVAILABLE|DEADLINE_EXCEEDED|DATA_LOSS|UNIMPLEMENTED|RESOURCE_EXHAUSTED\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
